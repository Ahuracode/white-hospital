; Engine configuration file.
; White Hospital — new 2D pixel top-down game (Godot 4.7.2)

config_version=5

[application]

config/name="White Hospital"
config/description="2D pixel top-down game. One continuous white floor, light walls, one full hospital floor (72x44 tiles)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1152
window/size/viewport_height=704
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
